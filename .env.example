# 高德开放平台 Web端（JS API）Key
VITE_AMAP_KEY=

# 本地演示可使用安全密钥；正式环境建议改用下方服务端代理地址
VITE_AMAP_SECURITY_CODE=

# 可选：安全代理的源站，例如 https://map-api.example.com（不要包含 /_AMapService）
VITE_AMAP_SERVICE_HOST=

# H5 调用独立 TypeScript 业务服务的地址
VITE_API_BASE_URL=http://localhost:8787

# TypeScript 业务服务
APP_ENV=development
PORT=8787
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MS=60000
